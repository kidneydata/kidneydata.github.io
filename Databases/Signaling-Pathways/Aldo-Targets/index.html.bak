        <style type="text/css">
body {
        margin:0;
        padding-right:40px;
        padding-left:40px;
        background:#FFF;
        font:80% Arial, Helvetica, sans-serif;
        color:#000000;
        line-height:180%;
}
#topbg 
    {
        position: absolute; top: 0; left: 0; z-index: -1;
        width: 100%; height: 143px;
        background: #00004d;
    }
h1{
        font-size:180%;
        font-weight:bold;
        color: red;
        text-align: center;
}
h2{
        clear:both;
        font-size:160%;
        font-weight:normal;
        color:#000;
        background-color:#DAE4F4;
        margin:0;
        padding:.5em 0;
}
a{
        text-decoration:none;
        color:#00F;	
}
p{
        clear:both;
        margin:0;
        padding:.5em 0;
}
pre{
        font:100% "Courier New", Courier, monospace;
}
img{
        border:none;
}
ul,li{
        margin:0;
        padding:0;
}
li{
        list-style:none;
        float:left;
        display:inline;
        margin-right:10px;
}
table, td, th{
        border:0px;
}
th{
        text-align:left;
}

/*  */

#preview{
        position:absolute;
        border:1px solid #ccc;
        background:#333;
        padding:5px;
        display:none;
        color:#fff;
        }

/*  */
        </style>
		
